# Configurações do Banco de Dados
DATABASE_URL="file:./dev.db"  # Ou sua connection string do PostgreSQL/MySQL da Nuvem

# Chaves de Segurança JWT (MUITO IMPORTANTE GERAR CHAVES LONGAS E ALEATÓRIAS)
# Estas chaves assinam os tokens do Administrador do painel, e as licenças dos clientes.
JWT_SECRET="sua_chave_secreta_super_segura_para_licencas_aqui"
JWT_ADMIN_SECRET="sua_chave_secreta_super_segura_para_o_painel_admin_aqui"

# Porta do Servidor
PORT=4000
