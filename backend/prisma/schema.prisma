// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// Para rodar local agora, usamos sqlite. No Coolify, mudamos para "postgresql"
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id       String  @id @default(uuid())
  name     String
  document String? // CNPJ/CPF
  status   String  @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELED

  // Controle de Heartbeat (Online/Offline)
  lastSeenAt DateTime?

  // Relacionamentos
  customization Customization?
  licenses      License[]
  auditLogs     AuditLog[]
  telemetries   Telemetry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customization {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  logoUrl      String?
  primaryColor String  @default("#000000")
  systemName   String  @default("NetControl")
}

model License {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  token     String   @unique // O JWT gerado
  expiresAt DateTime
  modules   String // JSON com os módulos liberados (ex: ["FINANCE", "SUPPORT"])

  createdAt DateTime @default(now())
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Vamos armazenar a senha com hash (bcrypt)
  name      String?  // Nome de exibição
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  action  String
  details String?
  ip      String?

  createdAt DateTime @default(now())
}

model Telemetry {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cpuUsage    Float
  ramUsage    Float
  activeUsers Int

  timestamp DateTime @default(now())
}
